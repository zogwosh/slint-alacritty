// Rust 与 Slint 共享的标签页展示模型；终端控制器本身只保存在 Rust 侧。
export struct TabData {
    id: int,
    title: string,
    terminal-active: bool,
    is-settings: bool,
}

// 设置页左侧展示的 Shell Profile 摘要；完整编辑字段由 Rust 单独同步。
export struct ShellProfileData {
    id: int,
    name: string,
    program: string,
    is-ssh: bool,
    is-default: bool,
}

// 固定应用动作对应的可编辑快捷键。
export struct ShortcutData {
    action: string,
    label: string,
    shortcut: string,
    pass-through: bool,
}

// 「终端」设置分区的一组表单值：Rust 用它下发已保存的设置，点「应用」时原样带回。
// 新增选项只需在这里加字段，不必在 SettingsView 与 MainWindow 之间逐项转发。
export struct TerminalSettingsData {
    font-index: int,
    font-size: int,
    scrollback-lines: int,
    scroll-lines: int,
    cursor-shape-index: int,
    cursor-blink: bool,
    copy-on-select: bool,
    right-click-paste: bool,
}

// 设置项的取值范围。真源是 Rust 侧的常量，启动时写入；Slint 只用它限制输入控件。
export global SettingsLimits {
    in-out property <int> min-font-size;
    in-out property <int> max-font-size;
    in-out property <int> max-scrollback-lines;
    in-out property <int> max-scroll-lines;
}
