import { DesignTokens } from "design-tokens.slint";
import { StatusBadge } from "components/status-badge.slint";
import { AppScrollBar } from "components/scroll-view.slint";

export component TerminalView inherits Rectangle {
    background: DesignTokens.color-canvas;

    in property <image> frame;
    in property <string> font-family: DesignTokens.font-mono;
    in property <length> font-size: DesignTokens.text-sm;
    in property <bool> terminal-active: true;
    in property <string> exit-message;
    in property <int> scroll-offset;
    in property <int> scroll-history-lines;
    // 用十个等宽字符实测单元宽度，比复制一个固定像素值更能适应字体度量。
    out property <length> cell-width: font-probe.preferred-width / 10;
    out property <length> cell-height: root.font-size + 5px;
    out property <int> column-count: max(2, floor(self.width / self.cell-width));
    out property <int> row-count: max(1, floor(self.height / self.cell-height));

    // 这些回调只描述 UI 事件；具体 ANSI 编码和终端模式判断在 Rust 中完成。
    callback key-input(string, bool, bool, bool, bool);
    callback viewport-resized(int, int);
    callback mouse-input(int, int, int, int, bool, bool, bool, bool);
    callback mouse-scroll(int, int, float, bool, bool, bool);
    callback scroll-to(int);
    // Slint 的后续字符事件不一定保留 AltGr 身份，因此单独跟踪按下状态。
    private property <bool> altgr-active;
    private property <bool> mouse-shift;
    private property <bool> mouse-alt;
    private property <bool> mouse-control;

    // Slint 的响应式属性变化会主动通知 Rust 调整 PTY 字符网格。
    changed column-count => {
        root.viewport-resized(root.column-count, root.row-count);
    }
    changed row-count => {
        root.viewport-resized(root.column-count, root.row-count);
    }

    terminal-focus := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;

        key-pressed(event) => {
            if (event.text == Key.AltGr) {
                root.altgr-active = true;
            } else if (root.terminal-active) {
                root.key-input(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.alt,
                    event.modifiers.shift,
                    root.altgr-active,
                );
            }
            accept
        }

        key-released(event) => {
            if (event.text == Key.AltGr) {
                root.altgr-active = false;
                accept
            } else {
                reject
            }
        }

        // frame 是 Rust/WGPU 生成的整张终端纹理，Slint 只负责合成显示。
        Image {
            width: 100%;
            height: 100%;
            source: root.frame;
            image-fit: fill;
        }

        // 不可见的字体探针仅用于计算 Cascadia Mono 的实际字符宽度。
        font-probe := Text {
            visible: false;
            text: "0000000000";
            font-family: root.font-family;
            font-size: root.font-size;
        }

        if !root.terminal-active : StatusBadge {
            x: DesignTokens.space-2;
            y: parent.height - self.height - DesignTokens.space-1-5;
            width: min(parent.width - DesignTokens.space-4, self.preferred-width);
            text: root.exit-message;
        }


        // 将连续像素坐标换算为离散字符格，并记录指针位于格子的左半或右半。
        mouse-area := TouchArea {
            width: 100%;
            height: 100%;
            mouse-cursor: text;

            pointer-event(event) => {
                root.mouse-shift = event.modifiers.shift;
                root.mouse-alt = event.modifiers.alt;
                root.mouse-control = event.modifiers.control;
                if (event.kind == PointerEventKind.down) {
                    terminal-focus.focus();
                }
                root.mouse-input(
                    min(root.column-count - 1, max(0, floor(self.mouse-x / root.cell-width))),
                    min(root.row-count - 1, max(0, floor(self.mouse-y / root.cell-height))),
                    event.button == PointerEventButton.left ? 0
                        : event.button == PointerEventButton.middle ? 1
                        : event.button == PointerEventButton.right ? 2 : 3,
                    event.kind == PointerEventKind.down ? 0
                        : event.kind == PointerEventKind.up ? 1
                        : event.kind == PointerEventKind.move ? 2 : 3,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.control,
                    (self.mouse-x - floor(self.mouse-x / root.cell-width) * root.cell-width)
                        >= root.cell-width / 2,
                );
            }

            double-clicked() => {
                root.mouse-input(
                    min(root.column-count - 1, max(0, floor(self.mouse-x / root.cell-width))),
                    min(root.row-count - 1, max(0, floor(self.mouse-y / root.cell-height))),
                    0, 4, root.mouse-shift, root.mouse-alt, root.mouse-control,
                    (self.mouse-x - floor(self.mouse-x / root.cell-width) * root.cell-width)
                        >= root.cell-width / 2,
                );
            }

            scroll-event(event) => {
                root.mouse-scroll(
                    min(root.column-count - 1, max(0, floor(self.mouse-x / root.cell-width))),
                    min(root.row-count - 1, max(0, floor(self.mouse-y / root.cell-height))),
                    event.delta-y / root.cell-height,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.control,
                );
                accept
            }
        }

        // 终端历史与其他页面复用同一个滚动条，不占用字符网格宽度。
        if root.scroll-history-lines > 0 : AppScrollBar {
            x: parent.width - self.width;
            y: DesignTokens.space-1;
            height: parent.height - 2 * DesignTokens.space-1;
            maximum: root.scroll-history-lines * 1px;
            page-size: root.row-count * 1px;
            value: -(root.scroll-history-lines - root.scroll-offset) * 1px;
            wheel-changes-value: false;
            scrolled => {
                root.scroll-to(round(root.scroll-history-lines + self.value / 1px));
            }
            wheel(delta-y, mouse-y, shift, alt, control) => {
                root.mouse-scroll(
                    root.column-count - 1,
                    min(root.row-count - 1, max(0, floor(mouse-y / root.cell-height))),
                    delta-y / root.cell-height,
                    shift,
                    alt,
                    control,
                );
            }
        }
    }

    init => {
        terminal-focus.focus();
        root.viewport-resized(root.column-count, root.row-count);
    }
}
