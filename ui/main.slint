import { DesignTokens } from "design-tokens.slint";
import { SettingsLimits, ShellProfileData, ShortcutData, TabData, TerminalSettingsData } from "models.slint";
import { TitleBar } from "components/title-bar.slint";
import { SettingsView } from "settings-view.slint";
import { TerminalView } from "terminal-view.slint";

export { SettingsLimits, ShellProfileData, ShortcutData, TabData, TerminalSettingsData }

// 应用根窗口：负责组合标题栏和终端视图，并向 Rust 暴露统一接口。
export component MainWindow inherits Window {
    title: root.terminal-title;
    preferred-width: 900px;
    preferred-height: 540px;
    min-width: 560px;
    min-height: 320px;
    background: DesignTokens.color-canvas;
    no-frame: true;
    resize-border-width: DesignTokens.space-1-5;

    // Rust 写入的活动会话状态和 GPU 共享纹理。
    in property <image> terminal-frame;
    in property <string> terminal-title: "Slint Terminal";
    in property <bool> terminal-active: true;
    in property <string> exit-message;
    in property <int> scroll-offset;
    in property <int> scroll-history-lines;
    in property <int> terminal-cursor-column;
    in property <int> terminal-cursor-row;
    in-out property <bool> search-open;
    in-out property <string> search-query;
    in property <int> search-result-current;
    in property <int> search-result-total;
    in property <int> search-focus-request;
    in property <[TabData]> tabs;
    in property <int> active-tab-id: -1;
    in property <int> active-tab-index: -1;
    in property <bool> settings-active;
    in property <[ShellProfileData]> shell-profiles;
    in property <[ShortcutData]> shortcuts;
    in-out property <int> settings-section;
    in-out property <int> selected-profile-id: -1;
    in-out property <string> profile-name-draft;
    in-out property <int> profile-kind-index;
    in-out property <string> profile-program-draft;
    in-out property <string> profile-arguments-draft;
    in-out property <string> profile-working-directory-draft;
    in-out property <string> profile-environment-draft;
    in-out property <string> profile-ssh-host-draft;
    in-out property <string> profile-ssh-user-draft;
    in-out property <int> profile-ssh-port-draft: 22;
    in-out property <string> profile-ssh-identity-file-draft;
    in-out property <string> profile-ssh-password-draft;
    in property <[string]> mono-fonts;
    in property <string> terminal-font-family: "Cascadia Mono";
    in property <int> terminal-font-size: 15;
    // 单元尺寸以物理像素整数为唯一真源（由 Rust 按当前缩放测量），逻辑尺寸只是派生值；
    // 这样列边界、行裁剪与 PTY 上报的像素尺寸在任何 DPI 下都保持一致。
    in property <float> scale-factor: 1.0;
    in property <int> terminal-cell-width-px: 9;
    in property <int> terminal-cell-height-px: 18;
    private property <length> terminal-cell-width: root.terminal-cell-width-px * 1px / root.scale-factor;
    private property <length> terminal-cell-height: root.terminal-cell-height-px * 1px / root.scale-factor;
    // Rust 写入已保存的终端设置；用户在设置页的修改也停留在这里，直到点「应用」回传。
    in-out property <TerminalSettingsData> terminal-settings-draft;
    in property <string> settings-message;
    in property <bool> settings-message-error;
    private property <bool> app-altgr-active;
    // 输入回调参数依次为文本、Ctrl、Alt、Shift、AltGr。
    // application-key-input 返回 true 时，窗口级快捷键会阻止事件继续传给输入框或终端。
    callback application-key-input(string, bool, bool, bool, bool) -> bool;
    callback key-input(string, bool, bool, bool, bool);
    callback ime-preedit(string);
    callback viewport-resized(int, int);
    callback frame-ready(int);
    callback mouse-input(int, int, int, int, bool, bool, bool, bool);
    callback mouse-scroll(int, int, float, bool, bool, bool);
    callback scroll-to(int);
    callback search-query-changed(string);
    callback search-step(bool);
    callback dismiss-search;
    callback new-tab;
    callback new-tab-with-profile(int);
    callback open-settings;
    callback select-tab(int);
    callback close-tab(int);
    callback select-profile(int);
    callback new-profile;
    callback save-profile(int, string, int, string, string, string, string, string, string, int, string, string);
    callback set-default-profile(int);
    callback remove-profile(int);
    callback save-terminal(TerminalSettingsData);
    callback save-shortcut(string, string, bool);
    callback drag-window(float, float);

    // Rust 读取这些派生尺寸来配置 PTY 网格和渲染纹理。
    out property <length> cell-width: terminal-view.cell-width;
    out property <length> cell-height: terminal-view.cell-height;
    out property <int> viewport-columns: terminal-view.column-count;
    out property <int> viewport-rows: terminal-view.row-count;
    out property <length> terminal-width: terminal-view.width;
    out property <length> terminal-height: terminal-view.height;
    out property <color> terminal-background-token: DesignTokens.color-terminal-background;
    out property <color> terminal-foreground-token: DesignTokens.color-terminal-foreground;
    out property <color> terminal-selection-token: DesignTokens.color-terminal-selection;
    out property <color> terminal-selection-text-token: DesignTokens.color-terminal-selection-text;
    out property <color> terminal-search-match-token: DesignTokens.color-terminal-search-match;
    out property <color> terminal-search-current-token: DesignTokens.color-terminal-search-current;

    // 终端纹理必须落在整数物理像素上，否则会被双线性重采样而发虚。
    pure function snap(value: length) -> length {
        return round(value * root.scale-factor / 1px) * 1px / root.scale-factor;
    }

    app-focus := FocusScope {
        width: 100%;
        height: 100%;

        capture-key-pressed(event) => {
            if (event.text == Key.AltGr) {
                root.app-altgr-active = true;
                return reject;
            }

            if root.search-open && event.text == Key.Escape {
                root.dismiss-search();
                return accept;
            }
            if root.search-open && event.text == Key.F3 {
                root.search-step(event.modifiers.shift);
                return accept;
            }

            // 设置页中的文本编辑快捷键必须继续传给获得焦点的 TextInput。
            // 终端页仍沿用应用级 Ctrl/Alt 快捷键策略。
            if (root.settings-active || terminal-view.search-input-focused)
                && event.modifiers.control && !event.modifiers.alt
                && (event.text == "a" || event.text == "A"
                    || event.text == "c" || event.text == "C"
                    || event.text == "v" || event.text == "V"
                    || event.text == "x" || event.text == "X"
                    || event.text == "y" || event.text == "Y"
                    || event.text == "z" || event.text == "Z") {
                return reject;
            }
            root.application-key-input(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                root.app-altgr-active,
            ) ? accept : reject
        }

        capture-key-released(event) => {
            if (event.text == Key.AltGr) {
                root.app-altgr-active = false;
            }
            reject
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: DesignTokens.color-canvas;

            title-bar := TitleBar {
            y: 0px;
            width: 100%;
            tabs: root.tabs;
            profiles: root.shell-profiles;
            active-tab-id: root.active-tab-id;
            active-tab-index: root.active-tab-index;
            close-window => { root.close(); }
            minimize-window => { root.minimized = true; }
            toggle-maximize => { root.maximized = !root.maximized; }
            drag-window(delta-x, delta-y) => { root.drag-window(delta-x, delta-y); }
            new-tab => { root.new-tab(); }
            new-tab-with-profile(id) => { root.new-tab-with-profile(id); }
            open-settings => { root.open-settings(); }
            select-tab(id) => { root.select-tab(id); }
            close-tab(id) => { root.close-tab(id); }
        }

            // 保留终端四周的呼吸空间，但让留白与终端使用同一个背景 Token。
            if !root.settings-active : Rectangle {
                x: 0px;
                y: title-bar.height;
                width: parent.width;
                height: parent.height - title-bar.height;
                background: DesignTokens.color-terminal-background;
            }

            terminal-view := TerminalView {
            x: root.snap(DesignTokens.space-2-5);
            y: root.snap(title-bar.height + DesignTokens.space-2);
            width: root.snap(parent.width - DesignTokens.space-2-5) - self.x;
            height: root.snap(parent.height - DesignTokens.space-2-5) - self.y;
            frame: root.terminal-frame;
            terminal-active: root.terminal-active;
            exit-message: root.exit-message;
            scroll-offset: root.scroll-offset;
            scroll-history-lines: root.scroll-history-lines;
            cursor-column: root.terminal-cursor-column;
            cursor-row: root.terminal-cursor-row;
            search-open: root.search-open;
            search-query <=> root.search-query;
            search-result-current: root.search-result-current;
            search-result-total: root.search-result-total;
            search-focus-request: root.search-focus-request;
            font-family: root.terminal-font-family;
            font-size: root.terminal-font-size * 1px;
            cell-width: root.terminal-cell-width;
            cell-height: root.terminal-cell-height;
            visible: !root.settings-active;
            key-input(text, control, alt, shift, altgr) => {
                root.key-input(text, control, alt, shift, altgr);
            }
            ime-preedit(text) => { root.ime-preedit(text); }
            viewport-resized(columns, rows) => {
                root.viewport-resized(columns, rows);
            }
            mouse-input(column, row, button, action, shift, alt, control, right-half) => {
                root.mouse-input(column, row, button, action, shift, alt, control, right-half);
            }
            mouse-scroll(column, row, lines, shift, alt, control) => {
                root.mouse-scroll(column, row, lines, shift, alt, control);
            }
            scroll-to(offset) => { root.scroll-to(offset); }
            search-query-changed(query) => { root.search-query-changed(query); }
            search-step(previous) => { root.search-step(previous); }
            dismiss-search => { root.dismiss-search(); }
        }

            settings-view := SettingsView {
            x: DesignTokens.space-2-5;
            y: title-bar.height + DesignTokens.space-2;
            width: parent.width - 2 * DesignTokens.space-2-5;
            height: parent.height - title-bar.height - DesignTokens.space-2 - DesignTokens.space-2-5;
            visible: root.settings-active;
            profiles: root.shell-profiles;
            shortcuts: root.shortcuts;
            section <=> root.settings-section;
            selected-profile-id <=> root.selected-profile-id;
            profile-name <=> root.profile-name-draft;
            profile-kind-index <=> root.profile-kind-index;
            profile-program <=> root.profile-program-draft;
            profile-arguments <=> root.profile-arguments-draft;
            profile-working-directory <=> root.profile-working-directory-draft;
            profile-environment <=> root.profile-environment-draft;
            profile-ssh-host <=> root.profile-ssh-host-draft;
            profile-ssh-user <=> root.profile-ssh-user-draft;
            profile-ssh-port <=> root.profile-ssh-port-draft;
            profile-ssh-identity-file <=> root.profile-ssh-identity-file-draft;
            profile-ssh-password <=> root.profile-ssh-password-draft;
            mono-fonts: root.mono-fonts;
            terminal-settings <=> root.terminal-settings-draft;
            message: root.settings-message;
            message-error: root.settings-message-error;
            select-profile(id) => { root.select-profile(id); }
            new-profile => { root.new-profile(); }
            save-profile(id, name, kind-index, program, arguments, working-directory, environment,
                         ssh-host, ssh-user, ssh-port, ssh-identity-file, ssh-password) => {
                root.save-profile(id, name, kind-index, program, arguments, working-directory,
                    environment, ssh-host, ssh-user, ssh-port, ssh-identity-file, ssh-password);
            }
            set-default-profile(id) => { root.set-default-profile(id); }
            remove-profile(id) => { root.remove-profile(id); }
            save-terminal(draft) => { root.save-terminal(draft); }
            save-shortcut(action, shortcut, pass-through) => {
                root.save-shortcut(action, shortcut, pass-through);
            }
            }
        }
    }
}
